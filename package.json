{
  "name": "pittan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:server": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "node --env-file-if-exists=.env dist/server/server/backup.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "2.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@tabler/icons-react": "3.46.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.21.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
